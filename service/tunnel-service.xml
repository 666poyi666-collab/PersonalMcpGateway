<service>
  <id>OpenAISecureMcpTunnel</id>
  <name>OpenAI Secure MCP Tunnel</name>
  <description>Outbound OpenAI Secure MCP Tunnel for Personal MCP Gateway.</description>
  <executable>powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\tunnel\run-service.ps1"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="PERSONAL_MCP_DATA_DIR" value="%PERSONAL_MCP_DATA_DIR%" />
  <depend>PoyiPersonalMcpGateway</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>20sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%PERSONAL_MCP_DATA_DIR%\service-logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMMdd</zipDateFormat>
  </log>
  <serviceaccount>
    <username>NT SERVICE\OpenAISecureMcpTunnel</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
