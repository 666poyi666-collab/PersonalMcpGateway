{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poyi.local/schemas/project-platform.schema.json",
  "title": "Poyi Project Platform Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standardVersion",
    "id",
    "name",
    "runtimeProject",
    "dataPolicy",
    "dataInventory",
    "mcp",
    "sync",
    "knownGaps"
  ],
  "properties": {
    "standardVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "runtimeProject": {
      "type": "boolean"
    },
    "dataPolicy": {
      "type": "string",
      "enum": [
        "cloud_allowed",
        "sensitive_cloud_allowed",
        "cloud_allowed_with_media_exclusions",
        "metadata_cloud_allowed_binaries_opt_in",
        "operational_metadata",
        "local_only"
      ]
    },
    "dataInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "dataPlane",
          "mcpExposure",
          "coverage",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "private",
              "sensitive",
              "secret"
            ]
          },
          "dataPlane": {
            "$ref": "#/$defs/dataPlane"
          },
          "mcpExposure": {
            "type": "string",
            "enum": [
              "tool",
              "resource",
              "both",
              "none"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "missing",
              "exempt"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataPlane",
        "allowedCloudRecords",
        "createsStateWhilePcOff"
      ],
      "properties": {
        "dataPlane": {
          "const": "local_only"
        },
        "allowedCloudRecords": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": [
              "last-heartbeat",
              "audit"
            ]
          }
        },
        "createsStateWhilePcOff": {
          "const": false
        }
      }
    },
    "credentialBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp",
        "sync",
        "shared"
      ],
      "properties": {
        "mcp": {
          "const": "oauth"
        },
        "sync": {
          "const": "device_token"
        },
        "shared": {
          "const": false
        }
      }
    },
    "mcp": {
      "$ref": "#/$defs/capability"
    },
    "sync": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "dataPlane",
        "authority",
        "routes",
        "contractId",
        "envelopeVersion",
        "supportsPcOff",
        "supportsBidirectionalDelta"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "dataPlane": {
          "$ref": "#/$defs/dataPlane"
        },
        "authority": {
          "type": "string",
          "enum": [
            "cloud",
            "device",
            "hybrid",
            "none"
          ]
        },
        "routes": {
          "type": "object",
          "required": [
            "exchange",
            "status"
          ],
          "properties": {
            "exchange": {
              "const": "/sync/v2/exchange"
            },
            "status": {
              "const": "/sync/v2/status"
            },
            "pairOffers": {
              "const": "/sync/v1/pair/offers"
            },
            "pairExchange": {
              "const": "/sync/v1/pair/exchange"
            }
          }
        },
        "contractId": {
          "const": "sync-envelope-v1"
        },
        "envelopeVersion": {
          "const": 1
        },
        "supportsPcOff": {
          "type": "boolean"
        },
        "supportsBidirectionalDelta": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDeployments",
        "releaseSetSha256",
        "evidenceFiles",
        "testCommands",
        "remoteProbes"
      ],
      "properties": {
        "releaseSetSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "sourceDeployments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "treeHashAlgorithm",
              "treeHash",
              "deployedVersion",
              "deployedAt",
              "evidenceId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "git",
                  "directory"
                ]
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              "treeHashAlgorithm": {
                "type": "string",
                "enum": [
                  "git-tree-sha1",
                  "git-tree-sha256",
                  "sha256-path-content-v1"
                ]
              },
              "treeHash": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
              },
              "deployedVersion": {
                "type": "string",
                "minLength": 1
              },
              "deployedAt": {
                "type": "string",
                "format": "date-time"
              },
              "evidenceId": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "git"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "commit"
                  ],
                  "properties": {
                    "treeHashAlgorithm": {
                      "enum": [
                        "git-tree-sha1",
                        "git-tree-sha256"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "treeHashAlgorithm": {
                      "const": "sha256-path-content-v1"
                    },
                    "treeHash": {
                      "pattern": "^[0-9a-fA-F]{64}$"
                    }
                  }
                }
              }
            ]
          }
        },
        "evidenceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "path",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "source-deployment",
                  "remote-probe",
                  "adb-device",
                  "pc-off-round",
                  "chatgpt-oauth-mcp",
                  "test-result"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        },
        "testCommands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "remoteProbes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "method",
              "url",
              "expectedStatus",
              "sourceDeploymentId",
              "evidenceId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "HEAD"
                ]
              },
              "expectedStatus": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "sourceDeploymentId": {
                "type": "string",
                "minLength": 1
              },
              "evidenceId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "chatgptMcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "appVersionId",
            "mcpUrl",
            "oauthConnected",
            "toolNames",
            "evidenceId"
          ],
          "properties": {
            "appId": {
              "type": "string",
              "pattern": "^asdk_app_[A-Za-z0-9_-]+$"
            },
            "appVersionId": {
              "type": "string",
              "pattern": "^asdk_app_v_[A-Za-z0-9_-]+$"
            },
            "mcpUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "oauthConnected": {
              "const": true
            },
            "toolNames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "adbDevices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "physicalDevice",
              "emulator",
              "adbState",
              "packageName",
              "appVersion",
              "artifactSha256",
              "deviceAttestationSha256",
              "sourceDeploymentId",
              "sourceTreeHash",
              "evidenceId"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "phone",
                  "tablet",
                  "watch",
                  "other"
                ]
              },
              "physicalDevice": {
                "const": true
              },
              "emulator": {
                "const": false
              },
              "adbState": {
                "const": "device"
              },
              "packageName": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
              },
              "appVersion": {
                "type": "string",
                "minLength": 1
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "deviceAttestationSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "sourceDeploymentId": {
                "type": "string",
                "minLength": 1
              },
              "sourceTreeHash": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$"
              },
              "evidenceId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pcOffRounds": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "mutationKind",
              "sourceDeviceRole",
              "pcIsolationMode",
              "pcUnavailable",
              "localServicesStopped",
              "cloudRevisionBefore",
              "cloudRevisionAfter",
              "mcpReadWhilePcUnavailable",
              "restartCatchupVerified",
              "exactlyOnceVerified",
              "tombstoneVerified",
              "startedAt",
              "finishedAt",
              "evidenceId"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "mutationKind": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "delete"
                ]
              },
              "sourceDeviceRole": {
                "type": "string",
                "enum": [
                  "phone",
                  "tablet",
                  "watch",
                  "other"
                ]
              },
              "pcIsolationMode": {
                "type": "string",
                "enum": [
                  "shutdown",
                  "all-local-participants-stopped"
                ]
              },
              "pcUnavailable": {
                "const": true
              },
              "localServicesStopped": {
                "const": true
              },
              "cloudRevisionBefore": {
                "type": "string",
                "pattern": "^c[0-9a-z]+$"
              },
              "cloudRevisionAfter": {
                "type": "string",
                "pattern": "^c[0-9a-z]+$"
              },
              "mcpReadWhilePcUnavailable": {
                "const": true
              },
              "restartCatchupVerified": {
                "const": true
              },
              "exactlyOnceVerified": {
                "const": true
              },
              "tombstoneVerified": {
                "type": "boolean"
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "evidenceId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "dataPolicy"
        ],
        "properties": {
          "dataPolicy": {
            "const": "local_only"
          }
        }
      },
      "then": {
        "properties": {
          "mcp": {
            "properties": {
              "status": {
                "const": "exempt"
              },
              "dataPlane": {
                "const": "local_only"
              }
            }
          },
          "sync": {
            "properties": {
              "status": {
                "const": "exempt"
              },
              "dataPlane": {
                "const": "local_only"
              },
              "authority": {
                "const": "none"
              },
              "contractId": {
                "const": "sync-envelope-v1"
              },
              "envelopeVersion": {
                "const": 1
              },
              "supportsPcOff": {
                "const": false
              },
              "supportsBidirectionalDelta": {
                "const": false
              }
            }
          },
          "dataInventory": {
            "items": {
              "properties": {
                "dataPlane": {
                  "const": "local_only"
                },
                "mcpExposure": {
                  "const": "none"
                },
                "coverage": {
                  "const": "exempt"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sync": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "sync": {
            "properties": {
              "supportsPcOff": {
                "const": true
              },
              "supportsBidirectionalDelta": {
                "const": true
              }
            }
          },
          "verification": {
            "required": [
              "adbDevices",
              "pcOffRounds"
            ],
            "properties": {
              "adbDevices": {
                "minItems": 1
              },
              "pcOffRounds": {
                "minItems": 3
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sync": {
            "required": [
              "supportsPcOff"
            ],
            "properties": {
              "supportsPcOff": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "sync": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sync": {
            "required": [
              "supportsBidirectionalDelta"
            ],
            "properties": {
              "supportsBidirectionalDelta": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "sync": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mcp": {
            "required": [
              "status",
              "dataPlane"
            ],
            "properties": {
              "status": {
                "const": "complete"
              },
              "dataPlane": {
                "not": {
                  "const": "local_only"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ]
      }
    }
  ],
  "$defs": {
    "dataPlane": {
      "type": "string",
      "enum": [
        "cloud_primary",
        "derived_projection",
        "snapshot_mirror",
        "local_only"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "missing",
        "exempt"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "dataPlane",
        "routes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "dataPlane": {
          "$ref": "#/$defs/dataPlane"
        },
        "routes": {
          "type": "object",
          "required": [
            "mcp",
            "health",
            "ready",
            "oauthResourceMetadata"
          ],
          "properties": {
            "mcp": {
              "const": "/mcp"
            },
            "health": {
              "const": "/healthz"
            },
            "ready": {
              "const": "/readyz"
            },
            "oauthResourceMetadata": {
              "const": "/.well-known/oauth-protected-resource/mcp"
            }
          }
        }
      }
    }
  }
}
