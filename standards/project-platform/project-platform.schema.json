{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poyi.local/schemas/project-platform.schema.json",
  "title": "Poyi Project Platform Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standardVersion",
    "id",
    "name",
    "runtimeProject",
    "dataPolicy",
    "dataInventory",
    "mcp",
    "sync",
    "knownGaps"
  ],
  "properties": {
    "standardVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "runtimeProject": {
      "type": "boolean"
    },
    "dataPolicy": {
      "type": "string",
      "enum": [
        "cloud_allowed",
        "sensitive_cloud_allowed",
        "cloud_allowed_with_media_exclusions",
        "metadata_cloud_allowed_binaries_opt_in",
        "operational_metadata",
        "local_only"
      ]
    },
    "dataInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "dataPlane",
          "mcpExposure",
          "coverage",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "private",
              "sensitive",
              "secret"
            ]
          },
          "dataPlane": {
            "$ref": "#/$defs/dataPlane"
          },
          "mcpExposure": {
            "type": "string",
            "enum": [
              "tool",
              "resource",
              "both",
              "none"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "missing",
              "exempt"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataPlane",
        "allowedCloudRecords",
        "createsStateWhilePcOff"
      ],
      "properties": {
        "dataPlane": {
          "const": "local_only"
        },
        "allowedCloudRecords": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": [
              "last-heartbeat",
              "audit"
            ]
          }
        },
        "createsStateWhilePcOff": {
          "const": false
        }
      }
    },
    "credentialBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp",
        "sync",
        "shared"
      ],
      "properties": {
        "mcp": {
          "const": "oauth"
        },
        "sync": {
          "const": "device_token"
        },
        "shared": {
          "const": false
        }
      }
    },
    "mcp": {
      "$ref": "#/$defs/capability"
    },
    "sync": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "dataPlane",
        "authority",
        "routes",
        "supportsPcOff",
        "supportsBidirectionalDelta"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "dataPlane": {
          "$ref": "#/$defs/dataPlane"
        },
        "authority": {
          "type": "string",
          "enum": [
            "cloud",
            "device",
            "hybrid",
            "none"
          ]
        },
        "routes": {
          "type": "object",
          "required": [
            "exchange",
            "status"
          ],
          "properties": {
            "exchange": {
              "const": "/sync/v1/exchange"
            },
            "status": {
              "const": "/sync/v1/status"
            }
          }
        },
        "supportsPcOff": {
          "type": "boolean"
        },
        "supportsBidirectionalDelta": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationCommit",
        "deployedRevision",
        "evidenceFiles",
        "testCommands",
        "remoteProbes"
      ],
      "properties": {
        "implementationCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "deployedRevision": {
          "type": "string",
          "minLength": 1
        },
        "evidenceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        },
        "testCommands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "executable",
              "arguments",
              "expectedExitCode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedExitCode": {
                "type": "integer"
              }
            }
          }
        },
        "remoteProbes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "expectedStatus"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "expectedStatus": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "dataPolicy"
        ],
        "properties": {
          "dataPolicy": {
            "const": "local_only"
          }
        }
      },
      "then": {
        "properties": {
          "mcp": {
            "properties": {
              "status": {
                "const": "exempt"
              },
              "dataPlane": {
                "const": "local_only"
              }
            }
          },
          "sync": {
            "properties": {
              "status": {
                "const": "exempt"
              },
              "dataPlane": {
                "const": "local_only"
              },
              "authority": {
                "const": "none"
              },
              "supportsPcOff": {
                "const": false
              },
              "supportsBidirectionalDelta": {
                "const": false
              }
            }
          },
          "dataInventory": {
            "items": {
              "properties": {
                "dataPlane": {
                  "const": "local_only"
                },
                "mcpExposure": {
                  "const": "none"
                },
                "coverage": {
                  "const": "exempt"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dataPlane": {
      "type": "string",
      "enum": [
        "cloud_primary",
        "derived_projection",
        "snapshot_mirror",
        "local_only"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "missing",
        "exempt"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "dataPlane",
        "routes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "dataPlane": {
          "$ref": "#/$defs/dataPlane"
        },
        "routes": {
          "type": "object",
          "required": [
            "mcp",
            "health",
            "ready",
            "oauthResourceMetadata"
          ],
          "properties": {
            "mcp": {
              "const": "/mcp"
            },
            "health": {
              "const": "/healthz"
            },
            "ready": {
              "const": "/readyz"
            },
            "oauthResourceMetadata": {
              "const": "/.well-known/oauth-protected-resource/mcp"
            }
          }
        }
      }
    }
  }
}
